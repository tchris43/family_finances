# Copy to .env.local and fill in real values.
# Never commit .env.local

# Neon Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js — generate with PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
AUTH_SECRET=replace-me
# Must include https:// in production (e.g. https://family-finances-topaz.vercel.app)
AUTH_URL=http://localhost:3000

# Shared household login created by npm run db:seed
SEED_EMAIL=you@example.com
SEED_PASSWORD=choose-a-strong-password
